<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Page</title>

    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.js"></script>

    <!-- Styles -->
    <link
      rel="stylesheet"
      href="//cdn.datatables.net/2.3.7/css/dataTables.dataTables.css"
    />
  </head>
  <body>
    <table id="order-table">
      <thead>
        <th>Time</th>
        <th>Name</th>
        <th>Email</th>
        <th>Flavor</th>
        <th>Cone</th>
        <th>timestamp</th>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order.timestamp.toLocaleString() %></td>
            <td><%= order.name %></td>
            <td><%= order.email %></td>
            <td><%= order.flavor %></td>
            <td><%= order.cone %></td>
            <td><%= order.toppings %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <script defer>
        $(document).ready(function () {
            new DataTable('#order-table');
        });
    </script>
  </body>
</html>
